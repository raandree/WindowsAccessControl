<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>NTFSPermission.AccessRule</Name>
      <ViewSelectedBy>
        <TypeName>NTFSPermission.AccessRule</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>Rights</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Inherited</Label></TableColumnHeader>
          <TableColumnHeader><Label>AppliesTo</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AccessRights</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AccessControlType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsInherited</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AppliesTo</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>NTFSPermission.AuditRule</Name>
      <ViewSelectedBy>
        <TypeName>NTFSPermission.AuditRule</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>Rights</Label></TableColumnHeader>
          <TableColumnHeader><Label>Audit</Label></TableColumnHeader>
          <TableColumnHeader><Label>Inherited</Label></TableColumnHeader>
          <TableColumnHeader><Label>AppliesTo</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AccessRights</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AuditFlags</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsInherited</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AppliesTo</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>NTFSPermission.Owner</Name>
      <ViewSelectedBy>
        <TypeName>NTFSPermission.Owner</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>SID</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SID</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>NTFSPermission.EffectiveAccess</Name>
      <ViewSelectedBy>
        <TypeName>NTFSPermission.EffectiveAccess</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>EffectiveRights</Label></TableColumnHeader>
          <TableColumnHeader><Label>RequestedRights</Label></TableColumnHeader>
          <TableColumnHeader><Label>Allowed</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EffectiveRights</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RequestedRights</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsAllowed</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>